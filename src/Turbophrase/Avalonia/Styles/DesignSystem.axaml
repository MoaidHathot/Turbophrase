<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="TpVoidBrush" Color="#FFF3F3F3" />
          <SolidColorBrush x:Key="TpShellBrush" Color="#FFFAFAFA" />
          <SolidColorBrush x:Key="TpAppBackground" Color="#B3F3F3F3" />
          <SolidColorBrush x:Key="TpHeroGradient" Color="#A8F8F8F8" />
          <SolidColorBrush x:Key="TpSurfaceBrush" Color="#C8FFFFFF" />
          <SolidColorBrush x:Key="TpSurfaceRaisedBrush" Color="#D9FFFFFF" />
          <SolidColorBrush x:Key="TpSurfaceHoverBrush" Color="#FFF6F6F6" />
          <SolidColorBrush x:Key="TpControlFillBrush" Color="#F2FBFBFB" />
          <SolidColorBrush x:Key="TpControlHoverBrush" Color="#FFF6F6F6" />
          <SolidColorBrush x:Key="TpControlPressedBrush" Color="#FFEDEDED" />
          <SolidColorBrush x:Key="TpStrokeBrush" Color="#33000000" />
          <SolidColorBrush x:Key="TpStrokeStrongBrush" Color="#66000000" />
          <SolidColorBrush x:Key="TpTextBrush" Color="#FF1A1A1A" />
          <SolidColorBrush x:Key="TpMutedTextBrush" Color="#FF5E5E5E" />
          <SolidColorBrush x:Key="TpSubtleTextBrush" Color="#FF767676" />
          <SolidColorBrush x:Key="TpSuccessBrush" Color="#FF0F7B0F" />
          <SolidColorBrush x:Key="TpDangerBrush" Color="#FFC42B1C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="TpVoidBrush" Color="#FF202020" />
          <SolidColorBrush x:Key="TpShellBrush" Color="#FF1F1F1F" />
          <SolidColorBrush x:Key="TpAppBackground" Color="#B3202020" />
          <SolidColorBrush x:Key="TpHeroGradient" Color="#A82A2A2A" />
          <SolidColorBrush x:Key="TpSurfaceBrush" Color="#C82B2B2B" />
          <SolidColorBrush x:Key="TpSurfaceRaisedBrush" Color="#D9333333" />
          <SolidColorBrush x:Key="TpSurfaceHoverBrush" Color="#FF3A3A3A" />
          <SolidColorBrush x:Key="TpControlFillBrush" Color="#F22D2D2D" />
          <SolidColorBrush x:Key="TpControlHoverBrush" Color="#FF3A3A3A" />
          <SolidColorBrush x:Key="TpControlPressedBrush" Color="#FF242424" />
          <SolidColorBrush x:Key="TpStrokeBrush" Color="#33FFFFFF" />
          <SolidColorBrush x:Key="TpStrokeStrongBrush" Color="#52FFFFFF" />
          <SolidColorBrush x:Key="TpTextBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="TpMutedTextBrush" Color="#FFE2E2E2" />
          <SolidColorBrush x:Key="TpSubtleTextBrush" Color="#FFC6C6C6" />
          <SolidColorBrush x:Key="TpSuccessBrush" Color="#FF6CCB5F" />
          <SolidColorBrush x:Key="TpDangerBrush" Color="#FFFF99A4" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <Color x:Key="TpAccentColor">#0078D4</Color>
      <Color x:Key="TpAccentHoverColor">#106EBE</Color>
      <Color x:Key="TpAccentPressedColor">#005A9E</Color>
      <Color x:Key="TpAccentSoftColor">#330078D4</Color>
      <Color x:Key="TpAccentSelectionColor">#550078D4</Color>
      <Color x:Key="TpAccentTextColor">#FFFFFFFF</Color>

      <SolidColorBrush x:Key="TpAcrylicTintBrush" Color="#8A202020" />
      <SolidColorBrush x:Key="TpAcrylicHeaderBrush" Color="#802A2A2A" />
      <SolidColorBrush x:Key="TpAcrylicCardBrush" Color="#CC2B2B2B" />
      <SolidColorBrush x:Key="TpAcrylicRaisedBrush" Color="#D9333333" />
      <SolidColorBrush x:Key="TpAcrylicControlBrush" Color="#B8454545" />
      <SolidColorBrush x:Key="TpAcrylicControlHoverBrush" Color="#CC505050" />
      <SolidColorBrush x:Key="TpAcrylicControlPressedBrush" Color="#CC383838" />

      <SolidColorBrush x:Key="TpAccentBrush" Color="{StaticResource TpAccentColor}" />
      <SolidColorBrush x:Key="TpAccent2Brush" Color="{StaticResource TpAccentColor}" />
      <SolidColorBrush x:Key="TpAccentHoverBrush" Color="{StaticResource TpAccentHoverColor}" />
      <SolidColorBrush x:Key="TpAccentPressedBrush" Color="{StaticResource TpAccentPressedColor}" />
      <SolidColorBrush x:Key="TpAccentSoftBrush" Color="{StaticResource TpAccentSoftColor}" />
      <SolidColorBrush x:Key="TpAccentSelectionBrush" Color="{StaticResource TpAccentSelectionColor}" />
      <SolidColorBrush x:Key="TpAccentTextBrush" Color="{StaticResource TpAccentTextColor}" />
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    <Setter Property="Background" Value="{DynamicResource TpAppBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TpTextBrush}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TpTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TpMutedTextBrush}" />
  </Style>

  <Style Selector="TextBlock.subtle">
    <Setter Property="Foreground" Value="{DynamicResource TpSubtleTextBrush}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="29" />
  </Style>

  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource TpAcrylicCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TpStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Border.softCard">
    <Setter Property="Background" Value="{DynamicResource TpAcrylicRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TpStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource TpAcrylicControlBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TpTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TpStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="SelectionBrush" Value="{DynamicResource TpAccentSelectionBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TpAccentBrush}" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource TpAccentBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource TpAcrylicControlBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TpTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TpStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <Style Selector="ComboBox:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource TpAccentBrush}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource TpAcrylicControlBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TpTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TpStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource TpAcrylicControlHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TpStrokeStrongBrush}" />
  </Style>

  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{DynamicResource TpAcrylicControlPressedBrush}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource TpAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TpAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TpAccentTextBrush}" />
  </Style>

  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource TpAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TpAccentHoverBrush}" />
  </Style>

  <Style Selector="Button.primary:pressed">
    <Setter Property="Background" Value="{DynamicResource TpAccentPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TpAccentPressedBrush}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TpTextBrush}" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TpTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TpSurfaceHoverBrush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TpAccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TpTextBrush}" />
  </Style>
</Styles>
